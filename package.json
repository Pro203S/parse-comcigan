{
    "name": "parse-comcigan",
    "version": "1.5.0",
    "description": "컴시간 알리미에서 시간표를 가져오는 라이브러리입니다.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "!dist/**/*.test.*"
    ],
    "author": "Pro203S",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "test": "npm run build && node --test dist/comcigan.test.js",
        "pack": "npm run clean && npm run build",
        "build": "tsc",
        "clean": "tsc --build --clean",
        "dev": "nodemon --exec ts-node src/index.ts",
        "watch": "tsc --watch"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./sandbox": {
            "types": "./dist/sandbox.d.ts",
            "default": "./dist/sandbox.js"
        }
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "axios": "^1.21.0",
        "cheerio": "^1.2.0",
        "dayjs": "^1.11.23",
        "iconv-lite": "^0.6.3",
        "quickjs-emscripten": "^0.32.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Pro203S/parse-comcigan.git"
    },
    "keywords": [
        "school",
        "timetable",
        "comcigan"
    ],
    "homepage": "https://github.com/Pro203S/parse-comcigan.git",
    "bugs": {
        "url": "https://github.com/Pro203S/parse-comcigan/issues"
    }
}
